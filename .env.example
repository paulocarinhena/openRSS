# ── Dados ────────────────────────────────────────────
# Pasta com config.json (banco escolhido, segredo) e o arquivo SQLite.
OPENRSS_DATA_DIR=./data

# ── Banco (opcional) ─────────────────────────────────
# Deixe em branco para escolher o banco no assistente de primeira execução (/setup).
# Se definir, o assistente é pulado. O provider é inferido pela URL.
# DATABASE_URL=file:./data/openrss.db
# DATABASE_URL=postgresql://openrss:openrss@localhost:5432/openrss
# DATABASE_PROVIDER=sqlite   # ou postgresql; só necessário se a URL for ambígua

# ── App ──────────────────────────────────────────────
# URL pública do app (usada pelo Better Auth)
BETTER_AUTH_URL=http://localhost:3000
# Segredo das sessões e da criptografia das chaves de IA. Se vazio, é gerado no
# primeiro boot e salvo em <OPENRSS_DATA_DIR>/config.json. Não troque depois de
# cadastrar chaves de IA. Para definir manualmente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# APP_SECRET=

# Permite buscar feeds em IPs privados/localhost (ex.: RSS-Bridge na rede local)
ALLOW_PRIVATE_FEEDS=false
# Permite notificações de regras (webhooks) para IPs privados/localhost (ex.: ntfy na rede local)
ALLOW_PRIVATE_WEBHOOKS=false
# Desliga o agendador interno (útil em testes)
DISABLE_SCHEDULER=false

# ── Login único (OIDC, opcional) ─────────────────────
# Callback a cadastrar no provedor: <BETTER_AUTH_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://auth.exemplo.com/realms/casa
# OIDC_CLIENT_ID=openrss
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
# OIDC_AUTO_REGISTER=true
# OIDC_DISABLE_PASSWORD_LOGIN=false
