// Fonte única dos modelos. NÃO edite prisma/sqlite ou prisma/postgres diretamente:
// rode `npm run db:schemas` para regenerar os schemas por provider.
// Mantenha os modelos portáveis entre SQLite e Postgres (sem @db.*, sem arrays escalares).

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

// ─── Better Auth ─────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "admin" | "user"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  folders       Folder[]
  subscriptions Subscription[]
  articleStates UserArticle[]
  aiProviders   AiProvider[]
  ttsProviders  TtsProvider[]
  settings      UserSettings?
  digests       Digest[]
  chatThreads   ChatThread[]
  rules         Rule[]
  apiTokens     ApiToken[]
  tags          Tag[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Feeds ───────────────────────────────────────────────────

/// Feed é global (compartilhado entre usuários) e deduplicado pela URL.
model Feed {
  id            String    @id @default(cuid())
  url           String    @unique
  title         String
  siteUrl       String?
  description   String?
  iconUrl       String?
  etag          String?
  lastModified  String?
  lastFetchedAt DateTime?
  nextFetchAt   DateTime  @default(now())
  errorCount    Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions Subscription[]
  articles      Article[]

  @@index([nextFetchAt])
  @@map("feed")
}

model Folder {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  position      Int            @default(0)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]

  @@unique([userId, name])
  @@map("folder")
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedId      String
  feed        Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  customTitle String?
  createdAt   DateTime @default(now())

  @@unique([userId, feedId])
  @@index([feedId])
  @@map("subscription")
}

model Article {
  id              String    @id @default(cuid())
  feedId          String
  feed            Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade)
  guid            String
  url             String?
  title           String
  author          String?
  contentHtml     String?
  snippet         String?
  imageUrl        String?
  publishedAt     DateTime  @default(now())
  fullContentHtml String?
  storyId         String? // artigos de feeds diferentes sobre o mesmo fato compartilham este id
  createdAt       DateTime  @default(now())

  states    UserArticle[]
  summaries ArticleSummary[]
  audios    ArticleAudio[]
  ref       ArticleRef?
  tags      ArticleTag[]
  embedding ArticleEmbedding?

  @@unique([feedId, guid])
  @@index([feedId, publishedAt])
  @@index([publishedAt])
  @@index([storyId])
  @@map("article")
}

/// Estado do artigo por usuário. Ausência de linha = não lido.
model UserArticle {
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId      String
  article        Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  isRead         Boolean   @default(false)
  isSaved        Boolean   @default(false)
  readAt         DateTime?
  savedAt        DateTime?
  priorityScore  Int?
  priorityReason String?
  classifiedAt   DateTime?
  isHighlighted  Boolean   @default(false) // marcado por uma regra com a ação "destacar"

  @@id([userId, articleId])
  @@index([userId, isRead])
  @@index([userId, isSaved])
  @@map("user_article")
}

// ─── IA ──────────────────────────────────────────────────────

/// userId nulo = provedor global (cadastrado pelo admin).
model AiProvider {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String // "openai" | "anthropic" | "openrouter" | "openai_compatible"
  name            String
  baseUrl         String?
  apiKeyEncrypted String?
  defaultModel    String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("ai_provider")
}

/// Provedor de síntese de voz compatível com a API de áudio da OpenAI.
/// userId nulo = provedor global (cadastrado pelo admin).
model TtsProvider {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  baseUrl         String   @default("https://api.openai.com/v1")
  apiKeyEncrypted String?
  model           String
  voice           String
  responseFormat  String   @default("mp3")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  audios          ArticleAudio[]

  @@index([userId])
  @@map("tts_provider")
}

model UserSettings {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProviderId      String?
  aiModel           String?
  ttsProviderId     String?
  language          String   @default("pt-BR") // idioma da IA (resumos, digest, chat)
  uiLanguage        String   @default("pt-BR") // idioma da interface
  interests         String?
  classifyEnabled   Boolean  @default(false)
  digestEnabled     Boolean  @default(false)
  digestHour        Int      @default(7)
  digestEmail       Boolean  @default(false) // também envia o digest diário por e-mail (se houver SMTP)
  timezone          String   @default("America/Sao_Paulo")
  listView          String   @default("cards") // "titles" | "cards" | "magazine"
  groupStories      Boolean  @default(true) // agrupa na lista artigos de fontes diferentes sobre o mesmo fato
  updatedAt         DateTime @updatedAt

  @@map("user_settings")
}

model ArticleSummary {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  providerId String
  userId     String   @default("") // vazio para provedor global; dono da credencial para provedor pessoal
  model      String
  language   String
  kind       String   @default("summary") // "summary" | "translate"
  content    String
  createdAt  DateTime @default(now())

  @@unique([articleId, providerId, userId, model, language, kind], map: "article_summary_unique_key")
  @@map("article_summary")
}

/// Áudio TTS persistido. É removido automaticamente junto com o artigo.
model ArticleAudio {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  providerId  String
  provider    TtsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId      String   @default("")
  model       String
  voice       String
  format      String
  kind        String   // "article" | "summary"
  contentHash String
  content     Bytes
  createdAt   DateTime @default(now())

  @@unique([articleId, providerId, userId, model, voice, format, kind, contentHash], map: "article_audio_unique_key")
  @@index([articleId])
  @@map("article_audio")
}

model Digest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        String // YYYY-MM-DD no fuso do usuário
  content    String
  articleIds String // JSON array
  model      String?
  createdAt  DateTime @default(now())

  @@index([userId, day])
  @@index([userId, createdAt])
  @@map("digest")
}

model ChatThread {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String        @default("") // vazio = sem título (a UI mostra um placeholder traduzido)
  articleIds String        @default("[]") // JSON array de artigos de contexto
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_thread")
}

model ChatMessage {
  id        String     @id
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  parts     String // JSON do UIMessage.parts
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
  @@map("chat_message")
}

// ─── App ─────────────────────────────────────────────────────

/// Singleton (id = "app").
model AppSettings {
  id                     String  @id @default("app")
  bootstrapAdminEmail    String?
  allowRegistration      Boolean @default(false)
  refreshIntervalMinutes Int     @default(30)
  retentionDays          Int     @default(90)
  defaultAiProviderId    String?
  defaultAiModel         String?
  embeddingProviderId    String? // busca semântica: provedor global dos embeddings (null = desligada)
  embeddingModel         String?

  @@map("app_settings")
}

/// Lock simples para jobs em processo (evita execução duplicada em HMR / múltiplas instâncias).
// Regra automática do usuário: condições sobre artigos novos → ações no estado dele (UserArticle).
model Rule {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  enabled          Boolean   @default(true)
  scope            String    @default("all") // "all" | "feed" | "folder"
  scopeId          String? // id do feed ou da pasta
  matchAll         Boolean   @default(true) // true = todas as condições; false = qualquer uma
  conditions       String // JSON: [{ field, op, value }]
  actions          String // JSON: ["markRead" | "save" | "highlight" | "notify"]
  webhookEncrypted String? // URL do webhook (pode conter token), criptografada
  webhookFormat    String? // "json" | "ntfy" | "discord" | "slack" | "telegram"
  hitCount         Int       @default(0)
  lastHitAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@map("rule")
}

// Senha de aplicativo para clientes externos (API Google Reader e Fever). Só hashes ficam no banco.
model ApiToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  secretHash   String    @unique // sha256 da senha de aplicativo (Google Reader)
  feverKeyHash String    @unique // sha256 de md5("email:senha"), a api_key da Fever
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("api_token")
}

// Id inteiro e crescente de cada artigo: a API Fever e os ids curtos do Google Reader exigem números.
model ArticleRef {
  id        Int     @id @default(autoincrement())
  articleId String  @unique
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_ref")
}

// Ids inteiros estáveis de feeds e pastas para a API Fever.
model ApiRef {
  id    Int    @id @default(autoincrement())
  kind  String // "feed" | "folder"
  refId String

  @@unique([kind, refId])
  @@map("api_ref")
}

// Tags pessoais para organizar artigos (principalmente os salvos).
model Tag {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  articles  ArticleTag[]

  @@unique([userId, name])
  @@map("tag")
}

model ArticleTag {
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tagId, articleId])
  @@index([articleId])
  @@map("article_tag")
}

// Vetor do artigo (título + trecho) para a busca semântica. `modelKey` = "<provedor>:<modelo>":
// ao trocar de modelo, os vetores antigos deixam de valer e são refeitos aos poucos.
model ArticleEmbedding {
  articleId String   @id
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  modelKey  String
  vector    Bytes // Float32, normalizado (norma 1)
  createdAt DateTime @default(now())

  @@index([modelKey])
  @@map("article_embedding")
}

model JobLock {
  name      String   @id
  lockedAt  DateTime
  expiresAt DateTime

  @@map("job_lock")
}
